import asyncio
import os
import complexaudio as sa
import numpy as np
import wave
from google import genai
from google.genai import types
from dotenv import load_dotenv

# ====== AQUI ESTÁ O "LOCAL CERTO" ======
# 1. Carrega as variáveis do arquivo .env
load_dotenv()
# 2. Pega a chave da variável de ambiente
GOOGLE_API_KEY = os.getenv("GOOGLE_API_KEY=AIzaSyAIUnE-8ujL_zLgcFdM9gLkfAzdXhCRQuQ")

if not GOOGLE_API_KEY:
    print("ERRO: Chave de API não encontrada. Crie um arquivo .env com GOOGLE_API_KEY=sua_chave")
    exit(1)
# ========================================

# 3. Configura o cliente com a chave segura
client = genai.Client(api_key=GOOGLE_API_KEY, http_options={'api_version': 'v1alpha'})

async def main():
    async def receive_and_play_audio(session):
        """Recebe, reproduz e salva os chunks de áudio em tempo real."""
        print("...Ouvindo e gravando o áudio...")
        all_audio_chunks = []

        while True:
            async for message in session.receive():
                if message.server_content and message.server_content.audio_chunks:
                    audio_data = message.server_content.audio_chunks[0].data
                    all_audio_chunks.append(audio_data)
                    
                    audio_int16 = np.frombuffer(audio_data, dtype=np.int16)
                    play_obj = sa.play_buffer(audio_int16, num_channels=2, bytes_per_sample=2, sample_rate=48000)

            await asyncio.sleep(0.001)

        if all_audio_chunks:
            filename = "meu_cover_reggae.wav"
            print(f"\n💾 Salvando áudio em '{filename}'...")
            
            full_audio_data = b''.join(all_audio_chunks)
            
            with wave.open(filename, 'wb') as wav_file:
                wav_file.setnchannels(2)
                wav_file.setsampwidth(2)
                wav_file.setframerate(48000)
                wav_file.writeframes(full_audio_data)
            
            print(f"✅ Áudio salvo com sucesso como '{filename}'")
        else:
            print("⚠️  Nenhum dado de áudio foi recebido para salvar.")

    async with (
        client.aio.live.music.connect(model='models/lyria-realtime-exp') as session,
        asyncio.TaskGroup() as tg,
    ):
        print("🎵 Conectando à sessão de música...")
        tg.create_task(receive_and_play_audio(session))

        print("🎶 Configurando a vibe: Reggae lento e introspectivo...")
        await session.set_weighted_prompts(
            prompts=[
                types.WeightedPrompt(text='Reggae', weight=1.0),
                types.WeightedPrompt(text='Acoustic Guitar', weight=0.8),
                types.WeightedPrompt(text='Mellow', weight=0.9),
                types.WeightedPrompt(text='Slow Tempo', weight=0.7),
            ]
        )

        await session.set_music_generation_config(
            config=types.LiveMusicGenerationConfig(
                bpm=70,
                temperature=0.8,
                scale=types.Scale.C_SHARP_MINOR
            )
        )

        print("🔊 Gerando instrumental de reggae... (A música começará em instantes)")
        await session.play()
        await asyncio.sleep(45)

        print("\n⏹️  Finalizando a geração e salvando o arquivo...")
        await session.stop()

    print("✅ Sessão encerrada.")

if __name__ == "__main__":
    asyncio.run(main())
    
